@PACKAGE_INIT@

# The public header of fhhos4::Solver includes Eigen
include(CMakeFindDependencyMacro)
find_dependency(Eigen3 NO_MODULE)
# and mpi.h if the library is compiled with MPI
if(@FHHOS4_MPI@)
	find_dependency(MPI COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/fhhos4Targets.cmake")
check_required_components(fhhos4)
