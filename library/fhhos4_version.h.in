#pragma once
#include "fhhos4_error.h"

// Part of the public header <fhhos4>. Generated by CMake from library/fhhos4_version.h.in: the version is set in
// project() in CMakeLists.txt, and nowhere else.
#define FHHOS4_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define FHHOS4_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define FHHOS4_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define FHHOS4_VERSION "@PROJECT_VERSION@"

namespace fhhos4
{
	// Version of the library: FHHOS4_VERSION, followed by the commit it was built from (git describe) when it was built
	// from a git clone, e.g. "1.3.0 (v1.3.0-12-gabc1234-dirty)".
	FHHOS4_API const char* Version();
}
