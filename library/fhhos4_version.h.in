#pragma once
#include <cstdint>
#include "fhhos4_error.h"

// Part of the public header <fhhos4>. Generated by CMake from library/fhhos4_version.h.in: the version, set in project()
// in CMakeLists.txt and nowhere else, and the configuration of the compilation that the calling code must know.
#define FHHOS4_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define FHHOS4_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define FHHOS4_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define FHHOS4_VERSION "@PROJECT_VERSION@"

// The index type of the sparse matrices of fhhos4 (fhhos4::SparseMatrix): int, or intmax_t if fhhos4 is compiled with
// -DSMALL_INDEX=OFF
#define FHHOS4_SPARSE_INDEX @FHHOS4_SPARSE_INDEX@

namespace fhhos4
{
	// Version of the library: FHHOS4_VERSION, followed by the commit it was built from (git describe) when it was built
	// from a git clone, e.g. "1.3.0 (v1.3.0-12-gabc1234-dirty)".
	FHHOS4_API const char* Version();
}
